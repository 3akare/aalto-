{
  "manifest_version": 3,
  "name": "Aalto - Voice Access for Code-Switched Speech",
  "version": "0.4.0",
  "description": "Speak to fill forms, search, manage tabs and update Todoist, in naturally code-switched language. Built for people more fluent speaking than typing English.",
  "permissions": ["tabs", "activeTab", "scripting", "storage", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aalto"
  },
  "commands": {
    "start-listening": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Open Aalto and start listening"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["content-forms.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

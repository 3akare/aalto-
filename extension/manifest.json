{
  "manifest_version": 3,
  "name": "Aalto - voice agent for your browser",
  "version": "1.0.0",
  "description": "Talk to your browser. Aalto reads the page, fills forms, writes your text and drives your tabs - and never submits anything it hasn't read back to you.",
  "key": "",
  "permissions": ["tabs", "activeTab", "scripting", "storage", "offscreen", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aalto"
  },
  "commands": {
    "start-listening": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Start or end a conversation with Aalto"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-agent.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
